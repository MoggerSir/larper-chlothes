---
import { Icon } from "../react/Icon";
import { Logo } from "../react/Logo";

const trustPoints = [
  { icon: "lock" as const, label: "Secure checkout" },
  { icon: "shieldCheck" as const, label: "Condition checked" },
  { icon: "truck" as const, label: "Shipping across Mexico" },
];

const columns = [
  {
    title: "Store",
    links: [
      { label: "Inventory", href: "#inventory" },
      { label: "Products", href: "#products" },
      { label: "Benefits", href: "#benefits" },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "About Us", href: "#nosotros" },
      { label: "Student sellers", href: "#nosotros" },
      { label: "Item histories", href: "#products" },
    ],
  },
  {
    title: "Help",
    links: [
      { label: "Size guide", href: "#products" },
      { label: "Shipping", href: "#contacto" },
      { label: "Contact", href: "#contacto" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__trust">
    {
      trustPoints.map((point) => (
        <div class="site-footer__trust-item">
          <Icon name={point.icon} size={17} strokeWidth={1.4} />
          <span>{point.label}</span>
        </div>
      ))
    }
  </div>

  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <Logo tone="inverse" />
      <p class="site-footer__tagline">
        The students' second-hand clothing store in Cancún. Every item has one
        owner, one history, and one available unit.
      </p>
      <div class="site-footer__social">
        <a href="#" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
        <a href="#" aria-label="TikTok"><Icon name="tiktok" size={18} /></a>
        <a href="#" aria-label="WhatsApp"><Icon name="whatsapp" size={18} /></a>
      </div>
    </div>

    <nav class="site-footer__columns" aria-label="Site links">
      {
        columns.map((col) => (
          <div class="site-footer__col">
            <p class="eyebrow">{col.title}</p>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {new Date().getFullYear()} Larper Clothes. Student project.</p>
    <a href="#top" class="site-footer__top-link">
      Back to top
      <Icon name="arrowUpRight" size={13} />
    </a>
  </div>
</footer>
