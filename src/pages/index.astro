---
import { getImage } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Footer from "../components/sections/Footer.astro";
import { Hero } from "../components/react/Hero";
import { ProductGrid } from "../components/react/ProductGrid";
import { Lookbook } from "../components/react/Lookbook";
import { Editorial } from "../components/react/Editorial";
import { Newsletter } from "../components/react/Newsletter";
import { products, formatPrice } from "../data/products";

const lookbookProduct = products[1]; // Atrocity Layered Tee
const editorialProduct = products[2]; // Vice Quarter-Zip

const lookbookModelImg = await getImage({ src: lookbookProduct.images.model, width: 1600 });
const editorialModelImg = await getImage({ src: editorialProduct.images.model, width: 1200 });

const heroProducts = [
  products[0],
  products[1],
  products[2],
  products[3],
  products[4],
  products[7],
];
const heroModelPaths = [
  "/models/chamarra_Gothica_modelo_3D.glb",
  "/models/sudadera_gothica_modelo_3D.glb",
  "/models/sudadera_patriotica_modelo_3D.glb",
  "/models/Playera_de_linux_modelo_3D.glb",
  "/models/chamarra_cuero_cafe_modelo_3D.glb",
  "/models/Playera_Everlast_model_3d.glb?v=2",
];

const heroSlides = await Promise.all(
  heroProducts.map(async (product, index) => {
    const card = await getImage({ src: product.images.flat, width: 480 });
    const modelImage = await getImage({ src: product.images.model, width: 900 });
    return {
      id: product.id,
      index: product.index,
      name: product.name,
      colorway: product.colorway,
      priceLabel: formatPrice(product),
      tag: product.tag,
      description: product.description,
      model3dSrc: heroModelPaths[index],
      cardSrc: card.src,
      modelImageSrc: modelImage.src,
      label: product.label,
      category: product.category,
      sizes: product.category === "Pants" ? ["28", "30", "32", "34", "36"] : ["S", "M", "L", "XL"],
      colors: product.colorway.split(" / "),
    };
  }),
);

const productCards = await Promise.all(
  products.map(async (product) => {
    const flat = await getImage({ src: product.images.flat, width: 640 });
    const model = await getImage({ src: product.images.model, width: 640 });
    return {
      id: product.id,
      index: product.index,
      name: product.name,
      label: product.label,
      category: product.category,
      tag: product.tag,
      colorway: product.colorway,
      priceLabel: formatPrice(product),
      description: product.description,
      flatSrc: flat.src,
      modelSrc: model.src,
      sizes: product.category === "Pants" ? ["28", "30", "32", "34", "36"] : ["S", "M", "L", "XL"],
      colors: product.colorway.split(" / "),
    };
  }),
);

---

<Layout
  title="Larper Clothes — The Students' Second-Hand Store"
  description="A one-page store for second-hand clothes from university students in Cancún. Every item has a clear price, size, color, condition, and history."
>
  <Hero client:load slides={heroSlides} />

  <section class="section" id="inventory">
    <div class="container">
      <div class="section-head inventory-intro">
        <div>
          <span class="eyebrow">Current inventory</span>
          <h2 class="section-head__title">What is available today</h2>
        </div>
        <p class="section-head__copy">
          There are eight second-hand pieces in this collection. There are
          jackets, T-shirts, sweatshirts, and pants. There is only one unit of
          every style. There are clear details about each item's color, size,
          condition, price, and previous use.
        </p>
      </div>
      <div class="inventory-facts" aria-label="Inventory summary">
        <p><strong>08</strong><span>There are eight pieces.</span></p>
        <p><strong>01</strong><span>There is one of each.</span></p>
        <p><strong>100%</strong><span>There are only student listings.</span></p>
        <p><strong>MXN</strong><span>There is a clear price for every item.</span></p>
      </div>
      <div class="section-head section-head--products" id="products">
        <div>
          <span class="eyebrow">Products</span>
          <h2 class="section-head__title">The students' current edit</h2>
        </div>
        <p class="section-head__copy">
          This collection comes from students in our university community.
          Open a product to read the garment's full history and condition.
        </p>
      </div>
      <ProductGrid client:visible products={productCards} />
    </div>
  </section>

  <Lookbook
    client:visible
    imageSrc={lookbookModelImg.src}
    videoMp4Src="/media/about-runway.mp4"
    videoWebmSrc="/media/about-runway.webm"
    lines={[
      "Our store was a small campus idea.",
      "These clothes were part of a student's daily life.",
      "Every piece was checked before it entered the store.",
      "Now it is ready for another student's story.",
    ]}
  />

  <section class="section" id="benefits">
    <div class="container">
      <Editorial
        client:visible
        imageSrc={editorialModelImg.src}
        index={editorialProduct.index}
        name={editorialProduct.name}
        colorway={editorialProduct.colorway}
        priceLabel={formatPrice(editorialProduct)}
      />
    </div>
  </section>

  <div class="section--tight">
    <Newsletter client:visible />
  </div>

  <Footer />
</Layout>
